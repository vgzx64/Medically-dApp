# Runtime configuration of the dApp.
#
# Vite reads the env files of its own root, i.e. client/.env* — a .env in the
# repository root is NOT picked up. Copy this file to client/.env.local (or run
# `./tools/localnet.sh deploy`, which writes client/.env.local for you).
#
# RPC endpoint of the target network
VITE_RPC_URL=http://127.0.0.1:8545

# Expected chain id (31337 = Anvil, 11155111 = Sepolia)
VITE_CHAIN_ID=31337

# Wallet mode: "dev" (built-in Anvil test wallet) or "injected" (MetaMask)
VITE_WALLET_MODE=dev

# Private key of the built-in dev wallet (Anvil test key #0).
# NEVER use a real key here - this file is a template only.
VITE_DEV_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# PatientConsentRegistry address (written by tools/localnet.sh deploy)
VITE_CONTRACT_ADDRESS=

# Registrar address pre-filled in the registration form (needs REGISTRAR_ROLE)
VITE_REGISTRAR_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
